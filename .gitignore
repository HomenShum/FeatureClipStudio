node_modules/
out/
recordings/
.remotion/
*.log
# …except under promotion/evidence/, where a captured terminal session IS the
# artifact. Iteration 2's before/after proof for defect D1 is two of these, and
# `*.log` silently swallowed them on the first commit attempt.
!promotion/evidence/**/*.log
# The capturer regenerates these; the repo ships a worked example, so they ARE
# committed here. Uncomment to keep your own captures out of version control:
# public/wt/
# src/walkthrough.data.js

# secrets: the judge reads GEMINI_API_KEY from here, and this repo is pushed publicly
.env
.env.*
!.env.example

# piper TTS voices: 63MB binaries, fetched on demand
#   python -m piper.download_voices en_US-lessac-medium
*.onnx
*.onnx.json
out/.vo/
